{
  "description": "Boot claudemap dashboard server on session start; pre-build on install",
  "hooks": {
    "Setup": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "_R=\"${CLAUDE_PLUGIN_ROOT}\"; [ -z \"$_R\" ] && _R=$(ls -dt $HOME/.claude/plugins/cache/*/claudemap/[0-9]*/ 2>/dev/null | head -1); _R=\"${_R%/}\"; node \"$_R/scripts/smart-install.mjs\" || true",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "_R=\"${CLAUDE_PLUGIN_ROOT}\"; [ -z \"$_R\" ] && _R=$(ls -dt $HOME/.claude/plugins/cache/*/claudemap/[0-9]*/ 2>/dev/null | head -1); _R=\"${_R%/}\"; node \"$_R/scripts/boot-server.mjs\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
